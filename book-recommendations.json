[{% assign first = true %}{% for post in site.categories.Podcast %}{% for book in post.book_recommendations %}{% unless first %},{% endunless %}{% assign first = false %}
  {
    "url": {{ book.url | jsonify }},
    "title": {{ book.title | jsonify }},
    "author": {{ book.author | jsonify }},
    "recommended_by": {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | jsonify }}
    }
  }{% endfor %}{% endfor %}
]
