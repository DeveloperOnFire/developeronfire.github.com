#!/usr/bin/env bash
# Builds the site exactly as GitHub Pages does and runs every check against the
# rendered output, the source posts and the scripts. Each group runs even when an
# earlier one fails, so one run reports every kind of problem; the exit status
# is non-zero if any group failed. Dependency auditing lives in bin/audit because
# it needs the network and its result changes with the advisory database.
set -uo pipefail
cd "$(dirname "$0")/.."

status=0
run() {
  echo "==> $1"
  shift
  "$@" || { echo "FAILED: $*" >&2; status=1; }
}

export JEKYLL_ENV=production
run "build site" bundle exec jekyll build --destination _site

run "site checks" bundle exec ruby -Itest test/site_test.rb

if ! command -v node >/dev/null; then
  echo "FAILED: node is required for the script tests (test/js)" >&2
  status=1
elif ! ls test/js/*.test.js >/dev/null 2>&1; then
  echo "FAILED: no script tests found under test/js" >&2
  status=1
else
  run "script tests" node --test test/js/*.test.js
fi

exit $status
